DATABASE_URL=postgres://datacenterla:datacenterla@localhost:5434/datacenterla?sslmode=disable
HTTP_ADDR=:8082
JWT_SECRET=dev-secret-change-in-production-min-32-chars!!
JWT_ISSUER=DataCenterLA
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# E-mail — Resend (recomendado)
# ---------------------------------------------------------------------------
# Chave em https://resend.com/api-keys
RESEND_API_KEY=re_sua_chave_aqui
RESEND_FROM=Data Center LA <onboarding@resend.dev>

# Plano gratuito sem domínio: só envia para o e-mail cadastrado no Resend.
# Com domínio verificado: RESEND_FROM=Data Center LA <noreply@seudominio.com>

# ---------------------------------------------------------------------------
# Alternativas (opcional)
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# PIX — PDV loja física (QR dinâmico / copia e cola)
# ---------------------------------------------------------------------------
# Chave PIX cadastrada no banco (e-mail, CPF, CNPJ, telefone ou aleatória)
PIX_KEY=
PIX_MERCHANT_NAME=Data Center LA
PIX_MERCHANT_CITY=Asuncion

